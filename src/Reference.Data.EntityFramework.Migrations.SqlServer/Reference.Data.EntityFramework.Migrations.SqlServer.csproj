<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Reference.Data.EntityFramework.Migrations.SqlServer: the SQL Server-targeted IDesignTimeDbContextFactory and checked-in EF migrations for ReferenceDbContext. Migration tooling only — never referenced from a runtime container.</Description>
	</PropertyGroup>
	<ItemGroup>
		<!-- Ships the DDL scaffolder's own output inside the package DLL, so a DBA can pull the raw
		     CREATE script out of the NuGet package and run it against a blank instance without the
		     dotnet-ef CLI. Wildcard, not the literal schema/norse_reference.sql path: self-adapts if
		     the database name changes again without a csproj edit. -->
		<EmbeddedResource Include="schema/*.sql">
			<LogicalName>CreateScript.sql</LogicalName>
		</EmbeddedResource>
		<NorseDesignRef Include="Persistence.EntityFramework.Design">
			<Repo>Urdarbrunnr</Repo>
		</NorseDesignRef>
		<!-- Plain NorseRef, deliberately not NorseDesignRef: flows the SqlServer binding to the
		     migrations service — the seam generator discovers bindings through this closure, and a
		     PrivateAssets-blocked binding means NORSE030 (zero bindings found) in Yggdrasil. -->
		<NorseRef Include="Persistence.EntityFramework.SqlServer">
			<Repo>Urdarbrunnr</Repo>
		</NorseRef>
		<!-- dotnet-ef requires this directly on the tooling entry-point project — Urdarbrunnr's
		     Design chassis marks its own EFCore.Design reference PrivateAssets="all" so runtime
		     consumers never pull in design-time tooling, which also stops it reaching this leaf
		     project transitively. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.*-*">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<ProjectReference Include="../Reference.Data.EntityFramework.Migrations/Reference.Data.EntityFramework.Migrations.csproj" />
	</ItemGroup>
</Project>
